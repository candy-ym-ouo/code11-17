# ---- 应用 ----
NODE_ENV=production
APP_NAME=家中物品来历册
# 生成邀请/分享链接用的对外地址，必须与真实访问地址一致
APP_URL=http://localhost:4000
API_PORT=4000
LOG_LEVEL=info
# 构建后由 API 直接托管前端（apps/web/dist）；用 Nginx/Caddy 单独托管时设为 false
SERVE_WEB=true
WEB_DIST=./apps/web/dist

# ---- 数据库 ----
# scripts/pg.sh 用下面三项初始化本地集群；DATABASE_URL 是应用实际连接串，两者保持一致
POSTGRES_USER=heirloom
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=heirloom
# 本机 PostgreSQL（含 scripts/pg.sh 起的本地集群）
DATABASE_URL=postgresql://heirloom:change-me-please@127.0.0.1:5432/heirloom?schema=public
# 远程/托管数据库示例：
# DATABASE_URL=postgresql://user:pass@db.example.com:5432/heirloom?schema=public&sslmode=require

# ---- 认证 ----
# 必填，用 `openssl rand -hex 32` 生成；留空会导致服务启动失败
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d
COOKIE_SECURE=false

# ---- 存储 ----
STORAGE_ROOT=./data/uploads
# 冷层目录：建议挂到便宜大盘或移动硬盘；降冷的原始媒体搬到这里，读取时仍可流式访问并自动取回
COLD_STORAGE_ROOT=./data/cold
EXPORT_ROOT=./data/exports
BACKUP_ROOT=./data/backups
MAX_IMAGE_MB=25
MAX_AUDIO_MB=200
MAX_DOC_MB=50
# 冷层媒体被访问时是否自动后台取回热层
COLD_RESTORE_ON_ACCESS=true
# 家庭默认存储配额（GB），0 = 不限制；单个家庭可在「存储」设置里单独调整
DEFAULT_STORAGE_QUOTA_GB=0
# 清理预演的有效时长（小时）：过期必须重新预演，避免照旧计划执行
CLEANUP_PREVIEW_TTL_HOURS=24
# 音频转码与波形生成需要 ffmpeg（macOS: brew install ffmpeg；Debian/Ubuntu: apt install ffmpeg）
# 不在 PATH 里时给出绝对路径，例如 /opt/homebrew/bin/ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- 后台任务 ----
WORKER_ENABLED=true
WORKER_POLL_MS=2000
TRASH_RETENTION_DAYS=30
EXPORT_RETENTION_DAYS=7
# 按媒体类型的默认分层/保留策略（家庭未自定义时使用）
# 热层保留天数：0 = 一满足归档条件即可降冷；总保留天数：0 = 永不自动删除（删除始终需人工确认）
POLICY_IMAGE_HOT_DAYS=365
POLICY_AUDIO_HOT_DAYS=730
POLICY_DOCUMENT_HOT_DAYS=1095
POLICY_IMAGE_MAX_AGE_DAYS=0
POLICY_AUDIO_MAX_AGE_DAYS=0
POLICY_DOCUMENT_MAX_AGE_DAYS=0

# ---- 可选 ----
PUBLIC_SIGNUP=false
TZ=Asia/Shanghai
