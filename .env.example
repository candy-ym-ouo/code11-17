# ---- 应用 ----
NODE_ENV=production
APP_NAME=家中物品来历册
# 生成邀请/分享链接用的对外地址，必须与真实访问地址一致
APP_URL=http://localhost:4000
API_PORT=4000
LOG_LEVEL=info
# 构建后由 API 直接托管前端（apps/web/dist）；用 Nginx/Caddy 单独托管时设为 false
SERVE_WEB=true
WEB_DIST=./apps/web/dist

# ---- 数据库 ----
# scripts/pg.sh 用下面三项初始化本地集群；DATABASE_URL 是应用实际连接串，两者保持一致
POSTGRES_USER=heirloom
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=heirloom
# 本机 PostgreSQL（含 scripts/pg.sh 起的本地集群）
DATABASE_URL=postgresql://heirloom:change-me-please@127.0.0.1:5432/heirloom?schema=public
# 远程/托管数据库示例：
# DATABASE_URL=postgresql://user:pass@db.example.com:5432/heirloom?schema=public&sslmode=require

# ---- 认证 ----
# 必填，用 `openssl rand -hex 32` 生成；留空会导致服务启动失败
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d
COOKIE_SECURE=false

# ---- 存储 ----
STORAGE_ROOT=./data/uploads
EXPORT_ROOT=./data/exports
BACKUP_ROOT=./data/backups
MAX_IMAGE_MB=25
MAX_AUDIO_MB=200
MAX_DOC_MB=50
# 音频转码与波形生成需要 ffmpeg（macOS: brew install ffmpeg；Debian/Ubuntu: apt install ffmpeg）
# 不在 PATH 里时给出绝对路径，例如 /opt/homebrew/bin/ffmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- 后台任务 ----
WORKER_ENABLED=true
WORKER_POLL_MS=2000
TRASH_RETENTION_DAYS=30
EXPORT_RETENTION_DAYS=7

# 存储配额与冷热分层（新家庭默认值，0=不限；建家庭后以数据库内每家庭配置为准，可随时在「存储管理」修改）
STORAGE_DEFAULT_HOT_QUOTA_BYTES=0
STORAGE_DEFAULT_TOTAL_QUOTA_BYTES=0
# 上传超配额时硬拦截（false=只告警不拦截）
STORAGE_QUOTA_ENFORCE_UPLOAD=true
# 清理预演单有效期（小时）：过期必须重新预演才能执行
STORAGE_PLAN_TTL_HOURS=24
# 读取时回写访问时间的节流间隔（毫秒，默认 6 小时），避免播放频繁导致写放大
STORAGE_ACCESS_TOUCH_MIN_MS=21600000

# ---- 可选 ----
PUBLIC_SIGNUP=false
TZ=Asia/Shanghai
